+syntax = "proto3";
+package spatial.supervisor.v1;
+import "process_scope.proto";
+import "native_scope.proto";
+
+// Private supervisor context. Recording this does not authorize issuer activation.
+message AuthorityLaunchBinding {
+  bytes issuer_id = 1;
+  bytes participant_id = 2;
+  uint64 registered_revision = 3;
+  bytes service_incarnation = 4;
+}
+enum AuthorityLaunchStage {
+  LAUNCH_STAGE_UNSPECIFIED = 0;
+  PREPARING = 1;
+  PREPARED = 2;
+  START_ATTEMPTED = 3;
+  CLEANUP_PENDING = 4;
+  OWNED_SCOPES_STOPPED = 5;
+}
+// Contains identities and checked receipts, never cookies or private keys.
+message AuthorityLaunchRecord {
+  uint32 schema_version = 1;
+  uint64 revision = 2;
+  AuthorityLaunchBinding binding = 3;
+  ProcessScopeIdentity process = 4;
+  NativeScopeIdentity native = 5;
+  AuthorityLaunchStage stage = 6;
+  ProcessScopeStopped process_stopped = 7;
+  NativeScopeStopped native_stopped = 8;
+}
+message AuthorityLaunchQuery {}
+message AuthorityLaunchRequest {
+  uint32 protocol_version = 1;
+  uint64 request_id = 2;
+  oneof operation {
+    AuthorityLaunchBinding prepare = 10;
+    AuthorityProcessLaunch start = 11;
+    AuthorityLaunchQuery inspect = 12;
+    AuthorityLaunchQuery stop = 13;
+  }
+}
+message AuthorityLaunchView {
+  AuthorityLaunchRecord record = 1;
+  NativeScopeReady ready = 2; // Only during live preparation. Never persisted.
+}
+message AuthorityLaunchError { string message = 1; }
+message AuthorityLaunchReply {
+  uint32 protocol_version = 1;
+  uint64 request_id = 2;
+  oneof outcome {
+    AuthorityLaunchView view = 10;
+    AuthorityLaunchError error = 11;
+  }
+}
