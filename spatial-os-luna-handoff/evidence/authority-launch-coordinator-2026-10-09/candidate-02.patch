+        pids=[int(p) for p in (self.cgroup/view.record.process.scope_name/'cgroup.procs').read_text().split()]
+        self.assertEqual(len(pids),2);pins=[os.pidfd_open(p) for p in pids]
+        for fd in pins:self.addCleanup(os.close,fd)
