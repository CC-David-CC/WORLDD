+    def cleanup_cgroups(self):
+        for path in self.cgroup.iterdir():
+            if not path.is_dir():continue
+            (path/'cgroup.kill').chmod(0o600);(path/'cgroup.kill').write_text('1\n')
+            limit=time.monotonic()+3
