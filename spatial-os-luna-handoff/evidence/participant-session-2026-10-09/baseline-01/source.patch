+}
+message AuthorityAuthenticationChallenge {
+  uint32 protocol_version = 1;
+  bytes issuer_id = 2;
+  bytes issuer_incarnation = 3;
+  bytes nonce = 4;
+  AuthorityAuthenticationBegin request = 5;
+  bytes connection_binding = 6;
+  uint32 lifetime_ms = 7;
+  string audience = 8;
+}
+message AuthorityAuthenticationComplete { bytes nonce = 1; KeyProof proof = 2; }
+message AuthorityAuthenticationResult {
+  bytes issuer_id = 1;
+  bytes issuer_incarnation = 2;
+  AuthorityParticipantRecord registration = 3;
+  bytes service_incarnation = 4;
+  bytes connection_binding = 5;
+  uint64 security_revision = 6;
 }
 
