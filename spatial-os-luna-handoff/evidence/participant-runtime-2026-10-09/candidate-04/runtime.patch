+            std::lock_guard lock(mutex);
+            if (!stop.stop_requested()) fail_locked(core::INVALID_ARGUMENT, "Invalid authority participant context or command", current_request);
+        } catch (const std::exception&) {
+            std::lock_guard lock(mutex);
