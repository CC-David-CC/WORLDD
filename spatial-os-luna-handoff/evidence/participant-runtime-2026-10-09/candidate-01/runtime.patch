+// Trusted authority component queues. These messages grant no actor access.
+message AuthorityParticipantRuntimeConfig {
+  uint32 protocol_version = 1;
+  string issuer_client_config = 2;
+  string private_key_path = 3;
+  bytes participant_id = 4;
+  uint64 registered_revision = 5;
+}
+message ParticipantCommand {
+  uint64 request_id = 1;
+  oneof operation {
+    AuthorityActivate activate = 10;
+    AuthorityApplied applied = 11;
+    AuthorityRelease release = 12;
+  }
+}
+message ParticipantUpdate {
+  uint32 protocol_version = 1;
+  uint64 request_id = 2;
+  oneof outcome {
+    AuthorityAuthenticationResult authenticated = 10;
+    RevocationBatch revocations = 11;
+    AuthorityActivationState activated = 12;
+    AuthorityActivationState applied = 13;
+    AuthorityActivationState released = 14;
+    spatial.core.v1.Error error = 15;
+  }
+}
