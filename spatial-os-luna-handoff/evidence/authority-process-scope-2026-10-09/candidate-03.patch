+syntax = "proto3";
+package spatial.supervisor.v1;
+
+// Private supervisor configuration. This is not an actor execution API.
+message AuthorityProcessLaunch {
+  string executable = 1;
+  repeated string arguments = 2; // Arguments after argv[0].
+}
+message ProcessScopeIdentity {
+  bytes launch_id = 1;
+  string scope_name = 2;
+  string boot_id = 3;
+  uint64 device = 4;
+  uint64 inode = 5;
+}
+message ProcessScopeState {
+  ProcessScopeIdentity identity = 1;
+  bool populated = 2;
+  bool direct_child_exited = 3;
+}
+message ProcessScopeStopped { ProcessScopeIdentity identity = 1; }
+message ProcessScopeQuery {}
+message ProcessScopeRequest {
+  uint32 protocol_version = 1;
+  uint64 request_id = 2;
+  oneof operation {
+    AuthorityProcessLaunch launch = 10;
+    ProcessScopeQuery state = 11;
+    ProcessScopeQuery stop = 12;
+  }
+}
+message ProcessScopeError {
+  enum Code {
+    UNSPECIFIED = 0;
+    INVALID_ARGUMENT = 1;
+    UNSUPPORTED_VERSION = 2;
+    INVALID_STATE = 3;
+    CLEANUP_UNCONFIRMED = 4;
+    LAUNCH_FAILED = 5;
+  }
+  Code code = 1;
+  string message = 2;
+}
+message ProcessScopeReply {
+  uint32 protocol_version = 1;
+  uint64 request_id = 2;
+  oneof outcome {
+    ProcessScopeState state = 10;
+    ProcessScopeStopped stopped = 11;
+    ProcessScopeError error = 12;
+  }
+}
