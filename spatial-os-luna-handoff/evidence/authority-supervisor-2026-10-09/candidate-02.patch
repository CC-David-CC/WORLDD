+                    require(request.has_inspect() || request.has_stop(), "Supervisor supports only inspect and stop");
+                    stop = request.has_stop();
+                } catch (const std::exception& error) { reply.mutable_error()->set_message(error.what()); }
+                if (!reply.has_error()) {
