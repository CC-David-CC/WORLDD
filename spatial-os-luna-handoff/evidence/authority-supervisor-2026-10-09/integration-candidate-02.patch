+syntax = "proto3";
+package spatial.supervisor.v1;
+import "process_scope.proto";
+import "native_scope.proto";
+import "issuer.proto";
+import "grants.proto";
+
+// Private supervisor context. Recording this does not authorize issuer activation.
+message AuthorityLaunchBinding {
+  bytes issuer_id = 1;
+  bytes participant_id = 2;
+  uint64 registered_revision = 3;
+  bytes service_incarnation = 4;
+  bool supervised = 5;
+}
+enum AuthorityLaunchStage {
+  LAUNCH_STAGE_UNSPECIFIED = 0;
+  PREPARING = 1;
+  PREPARED = 2;
+  START_ATTEMPTED = 3;
+  CLEANUP_PENDING = 4;
+  OWNED_SCOPES_STOPPED = 5;
+}
+// Contains identities and checked receipts, never cookies or private keys.
+message AuthorityLaunchRecord {
+  uint32 schema_version = 1;
+  uint64 revision = 2;
+  AuthorityLaunchBinding binding = 3;
+  ProcessScopeIdentity process = 4;
+  NativeScopeIdentity native = 5;
+  AuthorityLaunchStage stage = 6;
+  ProcessScopeStopped process_stopped = 7;
+  NativeScopeStopped native_stopped = 8;
+  spatial.identity.v1.AuthorityLaunchAuthorization authorization = 9;
+}
+message AuthorityParticipantAttach {
+  string runtime_config = 1;
+  repeated spatial.authority.v1.Domain domains = 2;
+}
+message AuthorityLaunchAuthorize {
+  string issuer_client_config = 1;
+  string private_key_path = 2;
+  uint64 supervision_revision = 3;
+  optional uint64 previous_generation = 4;
+}
+// Private local supervisor configuration. No actor receives this interface.
+message AuthoritySupervisorConfig {
+  uint32 protocol_version = 1;
+  string journal_directory = 2;
+  string delegated_cgroup = 3;
+  AuthorityLaunchBinding binding = 4;
+  AuthorityParticipantAttach participant = 5;
+  AuthorityLaunchAuthorize authorization = 6;
+  AuthorityProcessLaunch launch = 7;
+  string child_participant_config = 8;
+  uint32 participant_target_fd = 9;
+  repeated uint32 inherited_source_fds = 10;
+}
+message AuthorityParticipantChannelPrepare { uint32 target_fd = 1; }
+message AuthorityLaunchQuery {}
+message AuthorityLaunchRequest {
+  uint32 protocol_version = 1;
+  uint64 request_id = 2;
+  oneof operation {
+    AuthorityLaunchBinding prepare = 10;
+    AuthorityProcessLaunch start = 11;
+    AuthorityLaunchQuery inspect = 12;
+    AuthorityLaunchQuery stop = 13;
+    AuthorityParticipantAttach attach = 14;
+    AuthorityLaunchQuery participant_poll = 15;
+    AuthorityLaunchAuthorize authorize = 16;
+    spatial.identity.v1.ParticipantCommand participant_command = 17;
+    AuthorityParticipantChannelPrepare prepare_channel = 18;
+    AuthorityLaunchQuery pump_channel = 19;
+  }
+}
+message AuthorityLaunchView {
+  AuthorityLaunchRecord record = 1;
+  NativeScopeReady ready = 2; // Only during live preparation. Never persisted.
+}
+message AuthorityLaunchError { string message = 1; }
+message AuthorityLaunchReply {
+  uint32 protocol_version = 1;
+  uint64 request_id = 2;
+  oneof outcome {
+    AuthorityLaunchView view = 10;
+    AuthorityLaunchError error = 11;
+    spatial.identity.v1.ParticipantUpdate participant_update = 12;
+    spatial.identity.v1.AuthorityParticipantRuntimeConfig participant_config = 13;
+  }
+}
